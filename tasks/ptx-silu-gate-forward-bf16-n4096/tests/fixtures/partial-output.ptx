.version 9.2
.target sm_100
.address_size 64

// Deliberately wrong: each thread writes one element, so only 512/4096 output
// elements are initialized for every non-empty token row.
.visible .entry silu_gate_fwd_bf16_n4096(
    .param .u64 input_ptr,
    .param .u64 output_ptr,
    .param .u32 num_tokens
)
.maxntid 512, 1, 1
{
    .reg .pred %p<1>;
    .reg .b16 %h<4>;
    .reg .b32 %r<3>;
    .reg .b64 %rd<12>;
    .reg .f32 %f<10>;

    ld.param.u64 %rd0, [input_ptr];
    ld.param.u64 %rd1, [output_ptr];
    ld.param.u32 %r0, [num_tokens];
    mov.u32 %r1, %ctaid.x;
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 bra DONE;

    mul.wide.u32 %rd2, %r1, 16384;
    add.u64 %rd3, %rd0, %rd2;
    mul.wide.u32 %rd4, %r1, 8192;
    add.u64 %rd5, %rd1, %rd4;
    mov.u32 %r2, %tid.x;
    mul.wide.u32 %rd6, %r2, 2;
    add.u64 %rd7, %rd3, %rd6;
    add.u64 %rd8, %rd7, 8192;
    add.u64 %rd9, %rd5, %rd6;
    ld.global.b16 %h0, [%rd7];
    ld.global.b16 %h1, [%rd8];
    cvt.f32.bf16 %f0, %h0;
    cvt.f32.bf16 %f1, %h1;
    neg.f32 %f2, %f0;
    mul.f32 %f3, %f2, 0f3FB8AA3B;
    ex2.approx.ftz.f32 %f4, %f3;
    add.f32 %f5, %f4, 0f3F800000;
    rcp.approx.ftz.f32 %f6, %f5;
    mul.f32 %f7, %f0, %f6;
    mul.f32 %f8, %f7, %f1;
    cvt.rn.bf16.f32 %h2, %f8;
    st.global.b16 [%rd9], %h2;

DONE:
    ret;
}
