+++ b/tests/unit/environments/test_singularity_command_timeout.py
@@ -0,0 +1,13 @@
+from harbor.environments.singularity.singularity import _command_http_timeout
+
+
+def test_command_without_inner_timeout_uses_outer_phase_deadline() -> None:
+    assert _command_http_timeout(None) is None
+
+
+def test_command_timeout_keeps_transport_grace_period() -> None:
+    assert _command_http_timeout(30) == 40
+
+
+def test_long_command_timeout_is_not_capped_at_ten_minutes() -> None:
+    assert _command_http_timeout(3600) == 3610
