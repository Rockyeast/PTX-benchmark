+def _command_http_timeout(timeout_sec: int | None) -> int | None:
+    """Keep transport timeout outside the command deadline.
+
+    Agent phases already own their wall-clock deadline through ``asyncio.wait_for``.
+    When an installed agent does not pass a per-command timeout, imposing a hidden
+    600-second HTTP read timeout would silently cap longer task budgets.
+    """
+    return timeout_sec + 10 if timeout_sec is not None else None
+
