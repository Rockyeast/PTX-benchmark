index 00000000..22e3d6c0
--- /dev/null
+++ b/tests/unit/environments/test_singularity_network_guard.py
@@ -0,0 +1,113 @@
+import asyncio
+
+import pytest
+
+from harbor.environments.singularity.network_guard import (
+    handle_proxy_client,
+    host_is_allowed,
+    parse_connect_authority,
+)
+from harbor.environments.singularity.server import (
+    CommandRequest,
+    _guard_network_command,
+)
+
+
+def test_host_is_allowed_supports_exact_and_wildcard_rules() -> None:
+    allowed = ["api.openai.com", "*.example.internal"]
+    assert host_is_allowed("API.OPENAI.COM.", allowed)
+    assert host_is_allowed("model.example.internal", allowed)
+    assert not host_is_allowed("example.internal", allowed)
+    assert not host_is_allowed("api.openai.com.evil.invalid", allowed)
+
+
+@pytest.mark.parametrize(
+    ("authority", "expected"),
+    [
+        ("api.openai.com:443", ("api.openai.com", 443)),
+        ("[::1]:8443", ("::1", 8443)),
+    ],
+)
+def test_parse_connect_authority(authority, expected) -> None:
+    assert parse_connect_authority(authority) == expected
+
+
+@pytest.mark.parametrize(
+    "authority",
+    ["https://api.openai.com", "user@api.openai.com:443", "host", "host:0"],
+)
+def test_parse_connect_authority_rejects_unsafe_values(authority) -> None:
+    with pytest.raises(ValueError):
+        parse_connect_authority(authority)
+
+
+def test_guard_network_command_is_fail_closed() -> None:
+    public = _guard_network_command(CommandRequest(command="true"))
+    assert public == "true"
+
+    isolated = _guard_network_command(
+        CommandRequest(command="true", network_mode="no-network")
+    )
+    assert "unshare" in isolated
+    assert "isolated" in isolated
+
+    with pytest.raises(ValueError, match="proxy socket"):
+        _guard_network_command(CommandRequest(command="true", network_mode="allowlist"))
+
+
+@pytest.mark.asyncio
+async def test_connect_proxy_allows_only_configured_host(
+    monkeypatch,
+) -> None:
+    opened = []
+
+    class FakeReader:
+        def __init__(self, header):
+            self.header = header
+
+        async def readuntil(self, separator):
+            return self.header
+
+        async def read(self, size):
+            return b""
+
