+def _guard_network_command(req: CommandRequest) -> str:
+    """Wrap restricted phases in an unprivileged network namespace."""
+    if req.network_mode == "public":
+        return req.command
+    if req.network_mode not in {"no-network", "allowlist"}:
+        raise ValueError(f"unsupported network mode: {req.network_mode}")
+
+    helper_args = [
+        "/usr/bin/unshare",
+        "--user",
+        "--map-root-user",
+        "--net",
+        "/usr/bin/python3",
+        "/staging/network_guard.py",
+    ]
+    if req.network_mode == "no-network":
+        helper_args.append("isolated")
+    else:
+        if not req.network_proxy_socket:
+            raise ValueError("allowlist mode requires a network proxy socket")
+        helper_args.extend(["bridge", "--proxy-socket", req.network_proxy_socket])
+    helper_args.extend(["--", "/bin/bash", "-c", req.command])
+    return " ".join(_shell_quote(value) for value in helper_args)
+
+
 def _shell_quote(s: str) -> str:
     """Quote a string for safe use in shell commands."""
     return "'" + s.replace("'", "'\"'\"'") + "'"
