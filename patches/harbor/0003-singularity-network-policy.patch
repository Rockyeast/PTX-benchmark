+++ b/src/harbor/environments/singularity/network_guard.py
@@ -0,0 +1,324 @@
+"""Network namespace helpers for phase-scoped Singularity egress policy.
+
+The host-side ``proxy`` mode owns the only public-network socket.  The
+container-side ``bridge`` mode runs inside an unshared network namespace and
+forwards localhost HTTP CONNECT traffic over a Unix socket to that proxy.
+``isolated`` runs a command with loopback only and no egress bridge.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import fcntl
+import json
+import os
+import signal
+import socket
+import struct
+from pathlib import Path
+from typing import Iterable, Optional, Sequence, Tuple
+
+
+_MAX_HEADER_BYTES = 64 * 1024
+_SIOCGIFFLAGS = 0x8913
+_SIOCSIFFLAGS = 0x8914
+_IFF_UP = 0x1
+_IFF_RUNNING = 0x40
+
+
+def normalize_hostname(hostname: str) -> str:
+    """Return a comparison-safe ASCII hostname."""
+    normalized = hostname.strip().rstrip(".").lower()
+    if not normalized:
+        raise ValueError("hostname is empty")
+    return normalized.encode("idna").decode("ascii")
+
+
+def host_is_allowed(hostname: str, allowed_hosts: Iterable[str]) -> bool:
+    """Match Harbor exact hostnames and leading ``*.`` wildcards."""
+    candidate = normalize_hostname(hostname)
+    for raw_rule in allowed_hosts:
+        rule = normalize_hostname(raw_rule)
+        if rule.startswith("*."):
+            suffix = rule[1:]
+            if candidate.endswith(suffix) and candidate != suffix[1:]:
+                return True
+        elif candidate == rule:
+            return True
+    return False
+
+
+def parse_connect_authority(authority: str) -> Tuple[str, int]:
+    """Parse an HTTP CONNECT authority without accepting URLs or credentials."""
+    value = authority.strip()
+    if not value or "/" in value or "@" in value:
+        raise ValueError("invalid CONNECT authority")
+
+    if value.startswith("["):
+        closing = value.find("]")
+        if closing < 0:
+            raise ValueError("invalid bracketed IPv6 authority")
+        host = value[1:closing]
+        remainder = value[closing + 1 :]
+        if not remainder.startswith(":"):
+            raise ValueError("CONNECT authority must include a port")
+        port_text = remainder[1:]
+    else:
+        if value.count(":") != 1:
+            raise ValueError("CONNECT authority must be host:port")
+        host, port_text = value.rsplit(":", 1)
+
+    host = normalize_hostname(host)
+    try:
+        port = int(port_text)
+    except ValueError as exc:
+        raise ValueError("invalid CONNECT port") from exc
+    if not 1 <= port <= 65535:
+        raise ValueError("CONNECT port is out of range")
+    return host, port
+
+
+def _audit(event: str, **fields: object) -> None:
+    print(json.dumps({"event": event, **fields}, sort_keys=True), flush=True)
+
+
+async def _relay(reader: asyncio.StreamReader, writer: asyncio.StreamWriter) -> None:
+    try:
+        while True:
+            data = await reader.read(64 * 1024)
+            if not data:
+                break
+            writer.write(data)
+            await writer.drain()
+    except (ConnectionError, asyncio.CancelledError):
+        pass
+    finally:
+        try:
+            writer.write_eof()
+        except (AttributeError, OSError):
+            pass
+
+
+async def _close_writer(writer: asyncio.StreamWriter) -> None:
+    writer.close()
+    wait_closed = getattr(writer, "wait_closed", None)
+    if wait_closed is not None:
+        try:
+            await wait_closed()
+        except (ConnectionError, OSError):
+            pass
+
+
+async def handle_proxy_client(
+    reader: asyncio.StreamReader,
+    writer: asyncio.StreamWriter,
+    allowed_hosts: Sequence[str],
+) -> None:
+    """Accept one allowlisted HTTP CONNECT tunnel."""
+    remote_writer: Optional[asyncio.StreamWriter] = None
+    try:
+        header = await reader.readuntil(b"\r\n\r\n")
+        if len(header) > _MAX_HEADER_BYTES:
+            raise ValueError("proxy request header is too large")
+        first_line = header.split(b"\r\n", 1)[0].decode("ascii", errors="strict")
+        parts = first_line.split()
+        if len(parts) != 3 or parts[0].upper() != "CONNECT":
+            writer.write(b"HTTP/1.1 405 Method Not Allowed\r\n\r\n")
+            await writer.drain()
+            _audit("proxy_denied", reason="connect_required")
+            return
+
+        host, port = parse_connect_authority(parts[1])
+        if not host_is_allowed(host, allowed_hosts):
+            writer.write(b"HTTP/1.1 403 Forbidden\r\n\r\n")
+            await writer.drain()
+            _audit("proxy_denied", host=host, port=port, reason="not_allowlisted")
+            return
+
+        remote_reader, remote_writer = await asyncio.open_connection(host, port)
+        writer.write(b"HTTP/1.1 200 Connection Established\r\n\r\n")
+        await writer.drain()
+        _audit("proxy_allowed", host=host, port=port)
+        await asyncio.gather(
+            _relay(reader, remote_writer),
+            _relay(remote_reader, writer),
+        )
+    except (asyncio.IncompleteReadError, UnicodeDecodeError, ValueError) as exc:
+        writer.write(b"HTTP/1.1 400 Bad Request\r\n\r\n")
+        try:
+            await writer.drain()
+        except ConnectionError:
+            pass
+        _audit("proxy_denied", reason="bad_request", detail=str(exc))
+    except (ConnectionError, OSError) as exc:
+        writer.write(b"HTTP/1.1 502 Bad Gateway\r\n\r\n")
+        try:
+            await writer.drain()
+        except ConnectionError:
+            pass
+        _audit("proxy_error", detail=str(exc))
+    finally:
+        if remote_writer is not None:
+            await _close_writer(remote_writer)
+        await _close_writer(writer)
+
+
+async def run_proxy(socket_path: Path, allowed_hosts: Sequence[str]) -> int:
+    socket_path.parent.mkdir(parents=True, exist_ok=True)
+    socket_path.unlink(missing_ok=True)
+    server = await asyncio.start_unix_server(
+        lambda reader, writer: handle_proxy_client(reader, writer, allowed_hosts),
+        path=str(socket_path),
+    )
+    socket_path.chmod(0o600)
+    _audit("proxy_ready", socket=str(socket_path), allowed_hosts=list(allowed_hosts))
+
+    stop_event = asyncio.Event()
+    loop = asyncio.get_running_loop()
+    for sig in (signal.SIGINT, signal.SIGTERM):
+        try:
+            loop.add_signal_handler(sig, stop_event.set)
+        except NotImplementedError:
+            pass
+
+    try:
+        await stop_event.wait()
+    finally:
+        server.close()
+        await server.wait_closed()
+        socket_path.unlink(missing_ok=True)
+    return 0
+
+
+def bring_loopback_up() -> None:
+    """Enable ``lo`` without depending on iproute2 inside the SIF."""
+    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as control:
+        ifreq = struct.pack("16sH14x", b"lo", 0)
+        current = fcntl.ioctl(control.fileno(), _SIOCGIFFLAGS, ifreq)
+        _, flags = struct.unpack("16sH14x", current)
+        updated = struct.pack("16sH14x", b"lo", flags | _IFF_UP | _IFF_RUNNING)
+        fcntl.ioctl(control.fileno(), _SIOCSIFFLAGS, updated)
+
+
+def _clean_proxy_environment(env: dict[str, str]) -> dict[str, str]:
+    cleaned = dict(env)
+    for key in list(cleaned):
+        if key.lower() in {
+            "http_proxy",
+            "https_proxy",
+            "all_proxy",
+            "no_proxy",
+        }:
+            cleaned.pop(key, None)
+    return cleaned
+
+
+async def _bridge_client(
+    reader: asyncio.StreamReader,
+    writer: asyncio.StreamWriter,
+    proxy_socket: Path,
+) -> None:
+    unix_writer: Optional[asyncio.StreamWriter] = None
+    try:
+        unix_reader, unix_writer = await asyncio.open_unix_connection(str(proxy_socket))
+        await asyncio.gather(
+            _relay(reader, unix_writer),
+            _relay(unix_reader, writer),
+        )
+    finally:
+        if unix_writer is not None:
+            await _close_writer(unix_writer)
+        await _close_writer(writer)
+
+
+async def run_bridge(proxy_socket: Path, command: Sequence[str]) -> int:
+    if not command:
+        raise ValueError("bridge command is empty")
+    bring_loopback_up()
+    server = await asyncio.start_server(
+        lambda reader, writer: _bridge_client(reader, writer, proxy_socket),
+        host="127.0.0.1",
+        port=0,
+    )
+    sockets = server.sockets or []
+    if not sockets:
+        raise RuntimeError("bridge did not create a listening socket")
+    port = sockets[0].getsockname()[1]
+
+    env = _clean_proxy_environment(os.environ)
+    proxy_url = "http://127.0.0.1:{0}".format(port)
+    env.update(
+        {
+            "HTTP_PROXY": proxy_url,
+            "HTTPS_PROXY": proxy_url,
+            "http_proxy": proxy_url,
+            "https_proxy": proxy_url,
+            "NO_PROXY": "localhost,127.0.0.1",
+            "no_proxy": "localhost,127.0.0.1",
+        }
+    )
+
+    process = await asyncio.create_subprocess_exec(
+        *command,
+        env=env,
+        start_new_session=True,
+    )
+    try:
+        return await process.wait()
+    finally:
+        server.close()
+        await server.wait_closed()
+        if process.returncode is None:
+            try:
+                os.killpg(process.pid, signal.SIGTERM)
+            except ProcessLookupError:
+                pass
+            await process.wait()
+
+
+def run_isolated(command: Sequence[str]) -> int:
+    if not command:
+        raise ValueError("isolated command is empty")
+    bring_loopback_up()
+    env = _clean_proxy_environment(os.environ)
+    os.execvpe(command[0], list(command), env)
+    return 127
+
+
+def _command_after_separator(values: Sequence[str]) -> Sequence[str]:
+    if values and values[0] == "--":
+        return values[1:]
+    return values
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    parser = argparse.ArgumentParser()
+    subparsers = parser.add_subparsers(dest="mode", required=True)
+
+    proxy_parser = subparsers.add_parser("proxy")
+    proxy_parser.add_argument("--socket", type=Path, required=True)
+    proxy_parser.add_argument("--allow-host", action="append", default=[])
+
+    bridge_parser = subparsers.add_parser("bridge")
+    bridge_parser.add_argument("--proxy-socket", type=Path, required=True)
+    bridge_parser.add_argument("command", nargs=argparse.REMAINDER)
+
+    isolated_parser = subparsers.add_parser("isolated")
+    isolated_parser.add_argument("command", nargs=argparse.REMAINDER)
+
+    args = parser.parse_args(argv)
+    if args.mode == "proxy":
+        if not args.allow_host:
+            parser.error("proxy mode requires at least one --allow-host")
+        return asyncio.run(run_proxy(args.socket, args.allow_host))
+    if args.mode == "bridge":
+        command = _command_after_separator(args.command)
+        return asyncio.run(run_bridge(args.proxy_socket, command))
+    if args.mode == "isolated":
+        return run_isolated(_command_after_separator(args.command))
+    raise RuntimeError("unhandled network guard mode")
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
