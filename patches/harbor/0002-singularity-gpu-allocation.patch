+"""Best-effort local GPU leasing for direct-host Singularity trials."""
+
+import asyncio
+import logging
+import os
+import subprocess
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import IO
+
+if sys.platform != "win32":
+    import fcntl
+
+
+_CUDA_CONTEXT_PROBE = r"""
+import ctypes
+import sys
+
+cuda = ctypes.CDLL("libcuda.so.1")
+device_count = ctypes.c_int()
+device = ctypes.c_int()
+context = ctypes.c_void_p()
+
+checks = [
+    ("cuInit", cuda.cuInit(0)),
+    ("cuDeviceGetCount", cuda.cuDeviceGetCount(ctypes.byref(device_count))),
+]
+if checks[-1][1] == 0 and device_count.value < 1:
+    print("no CUDA devices visible", file=sys.stderr)
+    sys.exit(1)
+if all(result == 0 for _, result in checks):
+    checks.append(("cuDeviceGet", cuda.cuDeviceGet(ctypes.byref(device), 0)))
+if all(result == 0 for _, result in checks):
+    checks.append(
+        ("cuCtxCreate", cuda.cuCtxCreate_v2(ctypes.byref(context), 0, device))
+    )
+
+for operation, result in checks:
+    if result != 0:
+        print(f"{operation} failed with CUDA error {result}", file=sys.stderr)
+        sys.exit(1)
+
+if context.value:
+    cuda.cuCtxDestroy_v2(context)
+"""
+
+
+class GpuAllocationError(RuntimeError):
+    """Raised when a Singularity trial cannot reserve enough usable GPUs."""
+
+
+@dataclass
+class GpuLease:
+    """Advisory GPU locks held for one environment's complete lifetime."""
+
+    gpu_ids: tuple[int, ...]
+    _lock_files: list[IO[str]]
+
+    @property
+    def cuda_visible_devices(self) -> str:
+        return ",".join(str(gpu_id) for gpu_id in self.gpu_ids)
+
+    def release(self) -> None:
+        for lock_file in self._lock_files:
+            try:
+                if sys.platform != "win32":
+                    fcntl.flock(lock_file.fileno(), fcntl.LOCK_UN)
+            finally:
+                lock_file.close()
+        self._lock_files.clear()
+
+
+class GpuAllocator:
+    """Reserve idle GPUs using host inspection plus advisory file locks.
+
+    The lock prevents concurrent Harbor processes on the same host from choosing
+    the same GPU. External jobs do not participate in the lock, so live memory,
+    process, and CUDA-context checks are still required before each reservation.
+    """
+
+    def __init__(
+        self,
+        *,
+        allowed_gpu_ids: str | list[int] | tuple[int, ...] | None = None,
+        memory_threshold_mb: int = 256,
+        probe_context: bool = True,
+        lock_dir: Path | str = "/tmp",
+        logger: logging.Logger | None = None,
+    ) -> None:
+        if memory_threshold_mb < 0:
+            raise ValueError("singularity_gpu_memory_threshold_mb must be >= 0")
+        self._allowed_gpu_ids = self.normalize_gpu_ids(allowed_gpu_ids)
+        self._memory_threshold_mb = memory_threshold_mb
+        self._probe_context_enabled = probe_context
+        self._lock_dir = Path(lock_dir).expanduser()
+        self._logger = logger or logging.getLogger(__name__)
+
+    @staticmethod
+    def normalize_gpu_ids(
+        value: str | list[int] | tuple[int, ...] | None,
+    ) -> tuple[int, ...] | None:
+        if value is None:
+            return None
+        raw_values: list[str | int]
+        if isinstance(value, str):
+            raw_values = [part.strip() for part in value.split(",") if part.strip()]
+        else:
+            raw_values = list(value)
+        if not raw_values:
+            raise ValueError("singularity_gpu_ids must contain at least one GPU index")
+
+        gpu_ids: list[int] = []
+        for raw_value in raw_values:
+            try:
+                gpu_id = int(raw_value)
+            except (TypeError, ValueError) as exc:
+                raise ValueError(
+                    f"Invalid GPU index in singularity_gpu_ids: {raw_value!r}"
+                ) from exc
+            if gpu_id < 0:
+                raise ValueError("singularity_gpu_ids cannot contain negative indices")
+            if gpu_id not in gpu_ids:
+                gpu_ids.append(gpu_id)
+        return tuple(gpu_ids)
+
+    async def _run_command(
+        self,
+        command: list[str],
+        *,
+        env: dict[str, str] | None = None,
+        timeout_sec: float = 10.0,
+    ) -> subprocess.CompletedProcess[str]:
+        try:
+            return await asyncio.to_thread(
+                subprocess.run,
+                command,
+                capture_output=True,
+                text=True,
+                timeout=timeout_sec,
+                env=env,
+            )
+        except (FileNotFoundError, subprocess.TimeoutExpired) as exc:
+            raise GpuAllocationError(
+                f"GPU inspection command failed: {' '.join(command)}: {exc}"
+            ) from exc
+
+    async def _query_inventory(self) -> dict[int, int]:
+        result = await self._run_command(
+            [
+                "nvidia-smi",
+                "--query-gpu=index,memory.used",
+                "--format=csv,noheader,nounits",
+            ]
+        )
+        if result.returncode != 0:
+            message = result.stderr.strip() or result.stdout.strip()
+            raise GpuAllocationError(f"nvidia-smi GPU inventory failed: {message}")
+
+        inventory: dict[int, int] = {}
+        for line in result.stdout.splitlines():
+            fields = [field.strip() for field in line.split(",")]
+            if len(fields) != 2:
+                continue
+            try:
+                inventory[int(fields[0])] = int(fields[1])
+            except ValueError:
+                continue
+        if not inventory:
+            raise GpuAllocationError("nvidia-smi returned no parseable GPUs")
+        return inventory
+
+    async def _gpu_has_compute_process(self, gpu_id: int) -> tuple[bool, str]:
+        result = await self._run_command(
+            [
+                "nvidia-smi",
+                "-i",
+                str(gpu_id),
+                "--query-compute-apps=pid,process_name",
+                "--format=csv,noheader,nounits",
+            ]
+        )
+        if result.returncode != 0:
+            message = result.stderr.strip() or result.stdout.strip()
+            return True, f"process query failed: {message}"
+        processes = [
+            line.strip() for line in result.stdout.splitlines() if line.strip()
+        ]
+        if processes:
+            return True, f"compute processes: {'; '.join(processes)}"
+        return False, ""
+
+    async def _probe_gpu_context(self, gpu_id: int) -> tuple[bool, str]:
+        probe_env = os.environ.copy()
+        probe_env["CUDA_VISIBLE_DEVICES"] = str(gpu_id)
+        result = await self._run_command(
+            [sys.executable, "-c", _CUDA_CONTEXT_PROBE],
+            env=probe_env,
+        )
+        if result.returncode == 0:
+            return True, ""
+        message = result.stderr.strip() or result.stdout.strip()
+        return False, f"CUDA context probe failed: {message}"
+
+    def _try_lock(self, gpu_id: int) -> IO[str] | None:
+        if sys.platform == "win32":
+            raise GpuAllocationError("Singularity GPU allocation requires Linux")
+        self._lock_dir.mkdir(parents=True, exist_ok=True)
+        lock_path = self._lock_dir / f"harbor-singularity-gpu-{gpu_id}.lock"
+        file_descriptor = os.open(lock_path, os.O_RDONLY | os.O_CREAT, 0o666)
+        lock_file = os.fdopen(file_descriptor)
+        try:
+            fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            lock_file.close()
+            return None
+        return lock_file
+
+    async def acquire(self, count: int) -> GpuLease:
+        if count < 1:
+            return GpuLease((), [])
+
+        inventory = await self._query_inventory()
+        candidate_ids = self._allowed_gpu_ids or tuple(sorted(inventory))
+        selected_ids: list[int] = []
+        lock_files: list[IO[str]] = []
+        rejected: dict[int, str] = {}
+
+        for gpu_id in candidate_ids:
+            if gpu_id not in inventory:
+                rejected[gpu_id] = "not reported by nvidia-smi"
+                continue
+
+            lock_file = self._try_lock(gpu_id)
+            if lock_file is None:
+                rejected[gpu_id] = "leased by another Harbor trial"
+                continue
+
+            memory_mb = inventory[gpu_id]
+            if memory_mb > self._memory_threshold_mb:
+                rejected[gpu_id] = (
+                    f"memory.used={memory_mb} MiB exceeds "
+                    f"{self._memory_threshold_mb} MiB"
+                )
+                lock_file.close()
+                continue
+
+            has_process, process_reason = await self._gpu_has_compute_process(gpu_id)
+            if has_process:
+                rejected[gpu_id] = process_reason
+                lock_file.close()
+                continue
+
+            if self._probe_context_enabled:
+                healthy, probe_reason = await self._probe_gpu_context(gpu_id)
+                if not healthy:
+                    rejected[gpu_id] = probe_reason
+                    lock_file.close()
+                    continue
+
+            selected_ids.append(gpu_id)
+            lock_files.append(lock_file)
+            if len(selected_ids) == count:
+                lease = GpuLease(tuple(selected_ids), lock_files)
+                self._logger.info(
+                    "Reserved physical GPU(s) %s for this Singularity trial",
+                    lease.cuda_visible_devices,
+                )
+                return lease
+
+        partial_lease = GpuLease(tuple(selected_ids), lock_files)
+        partial_lease.release()
+        details = ", ".join(
+            f"GPU {gpu_id}: {reason}" for gpu_id, reason in rejected.items()
+        )
+        raise GpuAllocationError(
+            f"Requested {count} GPU(s), but only {len(selected_ids)} passed "
+            f"Singularity allocation checks. {details}"
+        )
