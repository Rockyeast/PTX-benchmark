index 0000000..4965548
--- /dev/null
+++ b/tests/unit/environments/test_singularity_gpu_allocator.py
@@ -0,0 +1,76 @@
+from unittest.mock import AsyncMock
+
+import pytest
+
+from harbor.environments.singularity.gpu_allocator import (
+    GpuAllocationError,
+    GpuAllocator,
+)
+
+
+def test_normalize_gpu_ids() -> None:
+    assert GpuAllocator.normalize_gpu_ids("3, 1,3") == (3, 1)
+    assert GpuAllocator.normalize_gpu_ids([2, 0]) == (2, 0)
+    assert GpuAllocator.normalize_gpu_ids(None) is None
+
+
+@pytest.mark.parametrize("value", ["", "-1", "gpu0"])
+def test_normalize_gpu_ids_rejects_invalid_values(value: str) -> None:
+    with pytest.raises(ValueError):
+        GpuAllocator.normalize_gpu_ids(value)
+
+
+def configured_allocator(tmp_path, gpu_ids: str = "0,1") -> GpuAllocator:
+    allocator = GpuAllocator(
+        allowed_gpu_ids=gpu_ids,
+        lock_dir=tmp_path,
+        memory_threshold_mb=256,
+    )
+    allocator._query_inventory = AsyncMock(return_value={0: 4, 1: 8})
+    allocator._gpu_has_compute_process = AsyncMock(return_value=(False, ""))
+    allocator._probe_gpu_context = AsyncMock(return_value=(True, ""))
+    return allocator
+
+
+@pytest.mark.asyncio
+async def test_concurrent_allocators_receive_distinct_gpus(tmp_path) -> None:
+    first_allocator = configured_allocator(tmp_path)
+    second_allocator = configured_allocator(tmp_path)
+
+    first_lease = await first_allocator.acquire(1)
+    second_lease = await second_allocator.acquire(1)
+    try:
+        assert first_lease.gpu_ids == (0,)
+        assert first_lease.cuda_visible_devices == "0"
+        assert second_lease.gpu_ids == (1,)
+    finally:
+        first_lease.release()
+        second_lease.release()
+
+
+@pytest.mark.asyncio
+async def test_failed_context_probe_skips_gpu(tmp_path) -> None:
+    allocator = configured_allocator(tmp_path)
+    allocator._probe_gpu_context = AsyncMock(
+        side_effect=[(False, "CUDA error 999"), (True, "")]
+    )
+
+    lease = await allocator.acquire(1)
+    try:
+        assert lease.gpu_ids == (1,)
+    finally:
+        lease.release()
+
+
+@pytest.mark.asyncio
+async def test_partial_allocation_is_released_on_failure(tmp_path) -> None:
+    allocator = configured_allocator(tmp_path, gpu_ids="0")
+    with pytest.raises(GpuAllocationError, match="Requested 2 GPU"):
+        await allocator.acquire(2)
+
+    next_allocator = configured_allocator(tmp_path, gpu_ids="0")
+    lease = await next_allocator.acquire(1)
+    try:
+        assert lease.gpu_ids == (0,)
+    finally:
+        lease.release()
