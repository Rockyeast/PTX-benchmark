diff --git a/src/harbor/environments/singularity/bootstrap.sh b/src/harbor/environments/singularity/bootstrap.sh
index d1b38687..c6fabc15 100755
--- a/src/harbor/environments/singularity/bootstrap.sh
+++ b/src/harbor/environments/singularity/bootstrap.sh
@@ -7,16 +7,23 @@ mkdir -p "$WORKDIR"
 
 export DEBIAN_FRONTEND=noninteractive
 
-# --- Refresh package index once (apt-based images) ---
-if command -v apt-get >/dev/null 2>&1; then
-  apt-get update -qq 2>/dev/null || true
-fi
+# Refresh apt metadata only if this image is actually missing a package.  A
+# prepared benchmark image already contains everything below, so an
+# unconditional apt-get update only adds network latency to every trial.
+_APT_UPDATED=0
+apt_update_once() {
+  if [ "$_APT_UPDATED" -eq 0 ] && command -v apt-get >/dev/null 2>&1; then
+    apt-get update -qq 2>/dev/null || true
+    _APT_UPDATED=1
+  fi
+}
 
 # --- Ensure /usr/bin/python3 exists ---
 _SYS_PY=/usr/bin/python3
 if [ ! -x "$_SYS_PY" ]; then
   echo "[harbor] /usr/bin/python3 not found, installing..." >&2
   if command -v apt-get >/dev/null 2>&1; then
+    apt_update_once
     apt-get install -y -qq python3 python3-venv 2>/dev/null || true
   elif command -v apk >/dev/null 2>&1; then
     apk add --no-cache python3 2>/dev/null || true
@@ -82,6 +89,7 @@ done
 if ! command -v tmux >/dev/null 2>&1; then
   echo "[harbor] Installing tmux..." >&2
   if command -v apt-get >/dev/null 2>&1; then
+    apt_update_once
     apt-get install -y -qq tmux 2>/dev/null || true
   elif command -v dnf >/dev/null 2>&1; then dnf install -y tmux 2>/dev/null || true
   elif command -v yum >/dev/null 2>&1; then yum install -y tmux 2>/dev/null || true
@@ -90,6 +98,7 @@ if ! command -v tmux >/dev/null 2>&1; then
 fi
 if ! command -v asciinema >/dev/null 2>&1; then
   if command -v apt-get >/dev/null 2>&1; then
+    apt_update_once
     apt-get install -y -qq asciinema 2>/dev/null || true
   elif command -v pip3 >/dev/null 2>&1; then
     pip3 install --break-system-packages asciinema 2>/dev/null || pip3 install asciinema 2>/dev/null || true
