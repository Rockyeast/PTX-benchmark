diff --git a/tests/unit/trial/test_instruction_mirror.py b/tests/unit/trial/test_instruction_mirror.py
new file mode 100644
index 0000000..18d362d
--- /dev/null
+++ b/tests/unit/trial/test_instruction_mirror.py
@@ -0,0 +1,88 @@
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from harbor.environments.base import ExecResult
+from harbor.models.task.config import TaskOS
+from harbor.trial.trial import (
+    Trial,
+    _instruction_mirror_paths,
+    _instruction_with_mirror_notice,
+)
+
+
+class _MirrorTrial(Trial):
+    async def _run(self) -> None:
+        pass
+
+    async def _recover_outputs(self) -> None:
+        pass
+
+
+class _FakeEnvironment:
+    def __init__(self) -> None:
+        self.empty_dirs_args = None
+        self.upload_target = None
+        self.uploaded_text = None
+        self.exec_args = None
+
+    async def empty_dirs(self, dirs, *, chmod=True):
+        self.empty_dirs_args = (dirs, chmod)
+        return ExecResult(stdout="", stderr="", return_code=0)
+
+    async def upload_file(self, source_path, target_path):
+        self.upload_target = target_path
+        self.uploaded_text = Path(source_path).read_text(encoding="utf-8")
+
+    async def exec(self, command, *, user=None):
+        self.exec_args = (command, user)
+        return ExecResult(stdout="", stderr="", return_code=0)
+
+
+def test_linux_instruction_mirror_path_is_outside_ptx_docs() -> None:
+    directory, path = _instruction_mirror_paths(TaskOS.LINUX)
+
+    assert directory.as_posix() == "/opt/task"
+    assert path.as_posix() == "/opt/task/instruction.md"
+
+
+def test_windows_instruction_mirror_path_is_drive_qualified() -> None:
+    directory, path = _instruction_mirror_paths(TaskOS.WINDOWS)
+
+    assert directory.as_posix() == "C:/task"
+    assert path.as_posix() == "C:/task/instruction.md"
+
+
+def test_mirror_notice_preserves_instruction_and_discloses_path() -> None:
+    instruction = "Implement the requested kernel.\n"
+
+    rendered = _instruction_with_mirror_notice(
+        instruction,
+        "/opt/task/instruction.md",
+    )
+
+    assert rendered.startswith("Implement the requested kernel.\n")
+    assert "`/opt/task/instruction.md`" in rendered
+    assert "reread that file at any time" in rendered
+
+
+@pytest.mark.asyncio
+async def test_mirror_uploads_exact_instruction_and_makes_it_read_only() -> None:
+    trial = object.__new__(_MirrorTrial)
+    environment = _FakeEnvironment()
+    trial.agent_environment = environment
+    trial.task = SimpleNamespace(
+        config=SimpleNamespace(environment=SimpleNamespace(os=TaskOS.LINUX))
+    )
+
+    path = await trial._mirror_agent_instruction("Exact task text.\n")
+
+    assert path == "/opt/task/instruction.md"
+    assert environment.upload_target == path
+    assert environment.uploaded_text == "Exact task text.\n"
+    assert environment.empty_dirs_args == ([Path("/opt/task")], True)
+    assert environment.exec_args == (
+        "chmod 0555 /opt/task && chmod 0444 /opt/task/instruction.md",
+        "root",
+    )
