+    async def _mirror_agent_instruction(self, instruction: str) -> str:
+        """Upload the effective instruction into the agent environment.
+
+        Harbor still passes the instruction as the agent's initial prompt. This
+        mirror is a convenience copy for long-running agents that need to reread
+        the original contract after substantial tool output or context compaction.
+        """
+        task_os = self.task.config.environment.os
+        instruction_dir, instruction_path = _instruction_mirror_paths(task_os)
+
+        prepare_result = await self.agent_environment.empty_dirs(
+            [instruction_dir],
+            chmod=True,
+        )
+        if prepare_result is not None and prepare_result.return_code != 0:
+            output = prepare_result.stderr or prepare_result.stdout or "no output"
+            raise RuntimeError(
+                "Failed to prepare the agent instruction directory "
+                f"{instruction_dir}: {output}"
+            )
+
+        with tempfile.TemporaryDirectory(prefix="harbor-instruction-") as temp_dir:
+            source_path = Path(temp_dir) / "instruction.md"
+            source_path.write_text(instruction, encoding="utf-8")
+            await self.agent_environment.upload_file(
+                source_path=source_path,
+                target_path=instruction_path.as_posix(),
+            )
+
+        if task_os != TaskOS.WINDOWS:
+            quoted_dir = quote_shell_arg(instruction_dir, task_os)
+            quoted_path = quote_shell_arg(instruction_path, task_os)
+            permission_result = await self.agent_environment.exec(
+                f"chmod 0555 {quoted_dir} && chmod 0444 {quoted_path}",
+                user="root",
+            )
+            if permission_result.return_code != 0:
+                output = (
+                    permission_result.stderr
+                    or permission_result.stdout
+                    or "no output"
+                )
+                raise RuntimeError(
+                    f"Failed to make {instruction_path} read-only: {output}"
+                )
+
+        return instruction_path.as_posix()
