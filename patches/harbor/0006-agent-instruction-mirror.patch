+def _instruction_mirror_paths(
+    task_os: TaskOS,
+) -> tuple[PurePosixPath, PurePosixPath]:
+    """Return the agent-visible directory and file for the task instruction."""
+    if task_os == TaskOS.WINDOWS:
+        instruction_dir = PurePosixPath("C:/task")
+    else:
+        instruction_dir = PurePosixPath("/opt/task")
+    return instruction_dir, instruction_dir / "instruction.md"
+
+
+def _instruction_with_mirror_notice(instruction: str, mirror_path: str) -> str:
+    """Tell the agent where Harbor mirrored the effective task instruction."""
+    return (
+        f"{instruction.rstrip()}\n\n"
+        "<harbor_runtime>\n"
+        "Harbor mirrored the exact effective task instruction at "
+        f"`{mirror_path}`. You may reread that file at any time.\n"
+        "</harbor_runtime>\n"
+    )
+
+
